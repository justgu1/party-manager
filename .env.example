# Copy to .env and adjust for your VPS deployment.
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the app, used to build password-reset links in emails.
APP_BASE_URL=https://party.seudominio.com

# Comma-separated admin emails. They are seeded on boot with a random password
# and receive a "set your password" email. Leave empty to use the built-in list.
ADMIN_EMAILS=

# YouTube Data API v3 key — enables searching songs by name in the Jukebox.
# Create a free key at https://console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# SMTP for sending the password-reset emails. If SMTP_HOST is empty, emails are
# logged to stdout instead (fine for local/dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=help-party <no-reply@help-party.local>
